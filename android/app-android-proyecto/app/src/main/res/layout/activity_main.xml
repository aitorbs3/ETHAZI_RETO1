<?xml version="1.0" encoding="utf-8"?>

<!--
    Layout principal de la pantalla de inicio.
    FrameLayout permite superponer elementos: en este caso,
    la imagen de fondo queda detrás del contenido de la aplicación.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Imagen de fondo que ocupa toda la pantalla.
         centerCrop ajusta la imagen al espacio disponible,
         recortando los bordes si es necesario. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_app"
        android:contentDescription="@string/cd_background" />

    <!-- Permite desplazarse verticalmente si el contenido
         supera la altura de la pantalla.
         fillViewport hace que el contenido ocupe como mínimo
         toda la altura disponible. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <!-- Contenedor vertical de los elementos de la interfaz.
             padding añade espacio interior de 24 dp. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Logotipo decorativo de la aplicación. -->
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:src="@drawable/destello" />

            <!-- Título principal.
                 El texto se obtiene de strings.xml para facilitar
                 su traducción a diferentes idiomas. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:fontFamily="serif"
                android:text="@string/app_title"
                android:textColor="@color/hogwarts_text_title"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Subtítulo que indica la función de búsqueda de alumnos. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/student_lookup"
                android:textColor="@color/hogwarts_text_title"
                android:textSize="14sp" />

            <!-- Selector de idioma.
                 MainActivity y LanguageManager gestionan el cambio
                 de idioma de la interfaz, sin traducir los datos
                 originales de los alumnos. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Etiqueta del selector de idioma. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/language_label"
                    android:textColor="@color/hogwarts_text_title"
                    android:textStyle="bold" />

                <!-- Spinner: lista desplegable de idiomas.
                     Su ID permite localizarlo desde Kotlin con findViewById
                     o mediante el sistema de View Binding utilizado. -->
                <Spinner
                    android:id="@+id/spinnerLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/language_label" />
            </LinearLayout>

            <!-- Tarjeta que contiene el campo de búsqueda.
                 MaterialCardView aporta esquinas redondeadas
                 y permite personalizar el fondo. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="32dp"
                app:cardBackgroundColor="@color/input_background"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <!-- Organiza horizontalmente el icono y el campo de texto. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <!-- Icono decorativo de la lupa. -->
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/lupa" />

                    <!-- Campo donde el usuario introduce el ID o el nombre.
                         El ID permite recuperar el texto desde Kotlin.
                         background="@null" elimina el fondo predeterminado.
                         imeOptions="actionSearch" configura la acción
                         de búsqueda en el teclado virtual. -->
                    <EditText
                        android:id="@+id/etSearchQuery"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="@string/search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:textColor="@color/hogwarts_text_title"
                        android:textColorHint="@color/hogwarts_text_muted"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Botón que inicia la búsqueda.
                 MainActivity debe asociar una acción a este ID
                 para procesar el texto introducido. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearch"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/hogwarts_blue_btn"
                android:text="@string/search_button"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                app:cornerRadius="27dp"
                app:elevation="4dp" />

            <!-- Botón para abrir la configuración de la URL del servidor
                 FastAPI, por ejemplo, para adaptar la dirección al
                 emulador o a un dispositivo físico. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnServerSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/config_api"
                android:textAllCaps="false"
                app:cornerRadius="16dp" />

            <!-- Botón para comprobar la conexión con la API.
                 La comprobación real debe implementarse en Kotlin. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestApi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/test_connection"
                android:textAllCaps="false"
                app:cornerRadius="16dp" />

            <!-- Muestra la URL actual del servidor.
                 Su contenido puede actualizarse desde MainActivity. -->
            <TextView
                android:id="@+id/tvServerUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="http://127.0.0.1:8000/"
                android:textColor="@color/hogwarts_text_muted"
                android:textSize="12sp" />

            <!-- Tarjeta que muestra información sobre la última búsqueda. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLastSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <!-- Distribuye horizontalmente el icono, los textos
                     y el icono de descarga. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <!-- Icono que representa el historial de búsquedas. -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/reloj" />

                    <!-- Contenedor de la etiqueta y el ID de la última búsqueda.
                         width=0dp junto con layout_weight=1 permite
                         aprovechar el espacio horizontal disponible. -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Etiqueta descriptiva de la tarjeta. -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/last_search"
                            android:textColor="@color/hogwarts_text_muted"
                            android:textSize="12sp" />

                        <!-- ID de la última búsqueda.
                             El guion largo es el valor inicial cuando
                             todavía no hay una búsqueda registrada. -->
                        <TextView
                            android:id="@+id/tvLastSearchId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="@color/hogwarts_text_title"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Icono decorativo de descarga. -->
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/descarga" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tarjeta informativa sobre la caché local. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <!-- Icono que representa una base de datos. -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/database" />

                    <!-- Información textual del estado de la caché. -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Título del estado de la caché.
                             Su texto puede cambiar dinámicamente desde Kotlin. -->
                        <TextView
                            android:id="@+id/tvCacheTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/local_cache_unavailable"
                            android:textColor="@color/hogwarts_text_title"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- Explicación del estado de disponibilidad sin conexión. -->
                        <TextView
                            android:id="@+id/tvCacheDescription"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/offline_unavailable"
                            android:textColor="@color/hogwarts_text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Indicador visual del estado de la caché Room.
                         Comienza con un punto gris; Kotlin puede cambiar
                         su fondo cuando detecta datos locales disponibles. -->
                    <View
                        android:id="@+id/cacheStatusIndicator"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/shape_gray_dot" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Separador visual que introduce la vista previa del alumno. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Línea decorativa izquierda. -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="1dp"
                    android:background="#CCCCCC" />

                <!-- Destello decorativo izquierdo. -->
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="8dp"
                    android:src="@drawable/destello" />

                <!-- Texto que identifica la sección de vista previa. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="@string/student_preview"
                    android:textColor="@color/hogwarts_text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Destello decorativo derecho. -->
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="8dp"
                    android:src="@drawable/destello" />

                <!-- Línea decorativa derecha. -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="1dp"
                    android:background="#CCCCCC" />
            </LinearLayout>

            <!-- Tarjeta que muestra un resumen del alumno encontrado.
                 MainActivity puede actualizar sus vistas con los datos
                 recibidos de la API o recuperados de la caché local. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStudentPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <!-- Organiza la fotografía, los datos y la flecha
                     en una única fila horizontal. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <!-- Fotografía del alumno.
                         ShapeableImageView permite aplicar una forma
                         personalizada mediante RoundedImageView.
                         usuario es la imagen inicial o de sustitución. -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgPreview"
                        android:src="@drawable/usuario"
                        android:contentDescription="@string/photo_student"
                        android:layout_width="80dp"
                        android:layout_height="90dp"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/RoundedImageView" />

                    <!-- Contenedor vertical de los datos resumidos del alumno.
                         El peso permite que ocupe el espacio sobrante
                         después de reservar espacio para la fotografía
                         y la flecha. -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Nombre del alumno.
                             no_preview es el texto inicial si aún
                             no se ha seleccionado ningún alumno. -->
                        <TextView
                            android:id="@+id/tvPreviewName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:text="@string/no_preview"
                            android:textColor="@color/hogwarts_text_title"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!-- Fila horizontal que agrupa la etiqueta ID
                             y el identificador real del alumno. -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <!-- Etiqueta fija del identificador. -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ID  "
                                android:textColor="@color/hogwarts_text_muted"
                                android:textSize="12sp" />

                            <!-- Identificador del alumno.
                                 El guion indica que todavía no hay datos. -->
                            <TextView
                                android:id="@+id/tvPreviewId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="@color/hogwarts_text_title"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Etiqueta del origen de los datos del alumno. -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/source"
                            android:textColor="@color/hogwarts_text_muted"
                            android:textSize="11sp" />

                        <!-- Origen de los datos.
                             Kotlin puede indicar, por ejemplo,
                             si proceden de la API o de la caché local. -->
                        <TextView
                            android:id="@+id/tvPreviewSource"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="@color/hogwarts_text_body"
                            android:textSize="12sp" />

                        <!-- Etiqueta del patronus del alumno. -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/patronus"
                            android:textColor="@color/hogwarts_text_muted"
                            android:textSize="11sp" />

                        <!-- Valor del patronus.
                             Se actualiza cuando se cargan los datos del alumno. -->
                        <TextView
                            android:id="@+id/tvPreviewPatronus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="@color/hogwarts_text_body"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Flecha que sugiere que existe una vista de detalle.
                         La navegación debe gestionarse desde Kotlin. -->
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/arrow" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</FrameLayout>