```xml
<?xml version="1.0" encoding="utf-8"?>

<!--
    Archivo de recursos de texto en inglés de la aplicación Hogwarts.
    Permite centralizar los textos de la interfaz para facilitar
    la internacionalización y el mantenimiento de la aplicación.
-->
<resources>

    <!-- Nombre de la aplicación que aparece en Android. -->
    <string name="app_name">Hogwarts</string>

    <!-- Título principal de la interfaz en inglés. -->
    <string name="app_title">Hogwarts Mobile</string>

    <!-- Texto que identifica la sección de consulta de alumnos. -->
    <string name="student_lookup">Student lookup</string>

    <!-- Texto de ayuda que aparece dentro del campo de búsqueda. -->
    <string name="search_hint">Search by ID or name</string>

    <!-- Texto del botón que inicia la búsqueda. -->
    <string name="search_button">Search ✦</string>

    <!-- Texto del botón para configurar la conexión con la API. -->
    <string name="config_api">Configure API</string>

    <!-- Texto del botón que comprueba la conexión con el servidor. -->
    <string name="test_connection">Test connection</string>

    <!-- Etiqueta que identifica la última búsqueda realizada. -->
    <string name="last_search">Last search</string>

    <!-- Mensaje que indica que la caché local no está disponible. -->
    <string name="local_cache_unavailable">Cache unavailable</string>

    <!-- Mensaje mostrado cuando no hay alumnos guardados para consultarlos sin conexión. -->
    <string name="offline_unavailable">No students are stored for offline access yet</string>

    <!-- Mensaje mostrado cuando el alumno solicitado no está guardado localmente. -->
    <string name="offline_student_unavailable">This student is not saved for offline access yet</string>

    <!-- Mensaje que indica que la caché local está activada. -->
    <string name="local_cache_enabled">Local cache enabled</string>

    <!-- Mensaje que indica que los alumnos consultados anteriormente están disponibles sin conexión. -->
    <string name="offline_available">Previously viewed students available offline</string>

    <!-- Título de la sección de vista previa del alumno. -->
    <string name="student_preview">STUDENT PREVIEW</string>

    <!-- Texto mostrado cuando no hay una vista previa disponible. -->
    <string name="no_preview">No preview</string>

    <!-- Etiqueta que identifica la procedencia de los datos. -->
    <string name="source">Source</string>

    <!-- Título de la pantalla con los datos detallados del alumno. -->
    <string name="student_details">Student details</string>

    <!-- Texto del botón para volver a la pantalla anterior. -->
    <string name="back">Back</string>

    <!-- Mensaje mostrado mientras se cargan los datos de un alumno. -->
    <string name="loading_student">Loading student...</string>

    <!-- Etiqueta que indica que los datos se han recuperado de la caché. -->
    <string name="cached">Cached</string>

    <!-- Etiqueta que indica que los datos pueden consultarse sin conexión. -->
    <string name="available_offline">Available offline</string>

    <!-- Etiqueta que identifica al alumno mediante su ID. -->
    <string name="student_id">Student ID</string>

    <!-- Etiqueta del alias del alumno. -->
    <string name="alias">Alias</string>

    <!-- Etiqueta de la casa de Hogwarts a la que pertenece el alumno. -->
    <string name="house">House</string>

    <!-- Etiqueta que indica la especie del alumno. -->
    <string name="species">Species</string>

    <!-- Etiqueta que indica el género del alumno. -->
    <string name="gender">Gender</string>

    <!-- Etiqueta de la fecha de nacimiento del alumno. -->
    <string name="birth">Date of birth</string>

    <!-- Etiqueta de la nacionalidad del alumno. -->
    <string name="nationality">Nationality</string>

    <!-- Etiqueta que identifica el Patronus del alumno. -->
    <string name="patronus">Patronus</string>

    <!-- Etiqueta que indica el origen del Patronus. -->
    <string name="patronus_origin">Patronus origin</string>

    <!-- Etiqueta de la base de datos de procedencia de los datos. -->
    <string name="source_database">Source database</string>

    <!-- Texto del botón para guardar la información correspondiente. -->
    <string name="save">Save</string>

    <!-- Texto del botón para iniciar una búsqueda nueva. -->
    <string name="new_search">New search</string>

    <!-- Etiqueta que identifica el nombre completo del alumno. -->
    <string name="student_name">Full name</string>

    <!-- Texto de ejemplo que muestra una casa de Hogwarts. -->
    <string name="choice_house_sample">House: Gryffindor</string>

    <!-- Texto utilizado para indicar que no existe ningún valor. -->
    <string name="none">None</string>

    <!-- Texto genérico para indicar que un dato no está disponible. -->
    <string name="unavailable">Not available</string>

    <!-- Etiqueta del selector de idioma de la aplicación. -->
    <string name="language_label">Language:</string>

    <!-- Descripción accesible de la fotografía del alumno. -->
    <string name="photo_student">Student photo</string>

    <!-- Descripción accesible del fondo de Hogwarts. -->
    <string name="cd_background">Hogwarts background</string>

    <!-- Valor de ejemplo para la casa del alumno. -->
    <string name="sample_house">Ravenclaw</string>

    <!-- Valor de ejemplo para la especie del alumno. -->
    <string name="sample_species">Human</string>

    <!-- Valor de ejemplo para el género del alumno. -->
    <string name="sample_gender">Male</string>

    <!-- Valor de ejemplo para la fecha de nacimiento. -->
    <string name="sample_birth">14 March 2007</string>

    <!-- Valor de ejemplo para la nacionalidad del alumno. -->
    <string name="sample_nationality">British or Irish</string>

    <!-- Valor de ejemplo para el Patronus del alumno. -->
    <string name="sample_patronus">Stag</string>

    <!-- Valor de ejemplo para la base de datos de procedencia. -->
    <string name="sample_source">Hogwarts Main Database</string>

    <!-- Instrucción que solicita introducir un nombre o ID para buscar. -->
    <string name="enter_student">Enter a student name or ID</string>

    <!-- Mensaje mostrado cuando no existen búsquedas anteriores. -->
    <string name="no_past_search">No previous searches</string>

    <!-- Mensaje de confirmación cuando la API responde correctamente. -->
    <string name="api_connected">API connected successfully</string>

    <!--
        Mensaje de error HTTP.
        %1$d es un parámetro numérico que se sustituye por el código HTTP,
        por ejemplo, 404 (recurso no encontrado) o 500 (error del servidor).
    -->
    <string name="api_http">FastAPI returned HTTP %1$d</string>

    <!--
        Mensaje de error de conexión.
        %1$s se sustituye por la descripción del error.
    -->
    <string name="connection_error">Connection error: %1$s</string>

    <!-- Título del campo donde se configura la dirección de FastAPI. -->
    <string name="server_title">FastAPI address</string>

    <!--
        Instrucciones para configurar la dirección de la API.
        127.0.0.1 se utiliza cuando se accede mediante adb reverse.
        10.0.2.2 permite al emulador Android acceder al ordenador anfitrión.
        En un móvil físico se utiliza la IP del ordenador conectado a la misma Wi-Fi.
        \n representa un salto de línea dentro del texto.
    -->
    <string name="server_hint">Emulator with adb reverse: http://127.0.0.1:8000/\nEmulator without adb reverse: http://10.0.2.2:8000/\nPhysical phone: http://PC_IP:8000/ (same Wi-Fi)</string>

    <!-- Texto del botón para cancelar una operación. -->
    <string name="cancel">Cancel</string>

    <!-- Texto del botón para guardar la dirección del servidor. -->
    <string name="save_server">Save</string>

    <!-- Mensaje mostrado cuando se guarda correctamente la dirección del servidor. -->
    <string name="server_saved">Server saved</string>

    <!--
        Mensaje mostrado cuando no se encuentran alumnos coincidentes.
        %1$s se sustituye por el texto introducido en la búsqueda.
    -->
    <string name="no_students">No students found matching “%1$s”</string>

    <!-- Mensaje que indica que no se ha encontrado el alumno solicitado. -->
    <string name="student_not_found">Student not found</string>

    <!-- Mensaje de error cuando falla la búsqueda y se debe comprobar la API. -->
    <string name="search_error">Search failed. Check the connection in “Configure API”.</string>

    <!-- Nombre utilizado cuando no se conoce el nombre del alumno. -->
    <string name="unknown_name">Unknown name</string>

    <!-- Valor utilizado cuando no se conoce la casa del alumno. -->
    <string name="unknown_house">Unknown</string>

    <!--
        Mensaje que muestra la casa seleccionada.
        %1$s se sustituye por el nombre de la casa.
    -->
    <string name="choice_house">House: %1$s</string>

    <!--
        Título que muestra el número de alumnos encontrados y el criterio de búsqueda.
        %1$d se sustituye por el número de alumnos.
        %2$s se sustituye por el nombre o ID buscado.
    -->
    <string name="choice_title">%1$d students matching “%2$s”</string>

    <!-- Mensaje mostrado cuando no se puede abrir la ficha seleccionada. -->
    <string name="cant_open_student">Could not open the selected student</string>

    <!-- Mensaje que solicita introducir un alumno antes de iniciar la búsqueda. -->
    <string name="no_student_query">Enter a student to search for</string>

    <!-- Mensaje mostrado cuando no se pueden cargar los datos del alumno. -->
    <string name="load_failed">Could not load student</string>

    <!--
        Mensaje que indica que no se han encontrado alumnos.
        %1$s se sustituye por el identificador o nombre buscado.
    -->
    <string name="missing_student">No students found matching “%1$s”.</string>

    <!--
        Mensaje de error HTTP.
        %1$d se sustituye por el código de estado HTTP recibido.
    -->
    <string name="http_error">HTTP %1$d: API response.</string>

    <!--
        Mensaje mostrado cuando no se puede conectar con el servidor.
        %1$s se sustituye por la dirección de la API.
        También orienta al usuario para comprobar Docker y la configuración.
    -->
    <string name="network_error">Could not connect to %1$s. Check Docker and the address in “Configure API”.</string>

    <!-- Mensaje genérico para errores que no tienen una descripción específica. -->
    <string name="unknown_error">Unknown error</string>

    <!--
        Mensaje mostrado cuando la URL introducida no es válida.
        Incluye un ejemplo de dirección válida.
    -->
    <string name="invalid_api_url">Enter a valid URL, for example http://127.0.0.1:8000/</string>

    <!-- Texto utilizado cuando no se conoce la base de datos de procedencia. -->
    <string name="unknown_source">Unknown database</string>

</resources>
```